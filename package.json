{
  "name": "pantry-log",
  "version": "1.0.0",
  "description": "A simple pantry inventory tracker — name, quantity, unit, and low-stock status.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "tesseract.js": "^5.1.1"
  }
}
